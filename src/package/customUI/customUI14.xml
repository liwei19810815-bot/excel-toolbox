<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  工具箱选项卡。

  约定：
    - 所有按钮统一 onAction="Ribbon_OnAction"，用 tag 携带 actionId。
      新增工具只需在这里加一个按钮 + 在 modAction 注册和转派，不用新增回调函数。
    - 【按钮上不写 label / screentip / supertip / enabled 的字面量】。
      这四项全部走 getXxx 回调，从 modAction 的注册表取。
      原先两边各写一份，结果按钮叫"删除重复"、撤销按钮却显示"撤销 删除重复值"；
      "点了还会追问参数"的省略号也漏在了问得最多的几个大按钮上。
      现在标签、省略号、可撤销标注都由注册表一处生成。
    - getEnabled 必须挂在每一个按钮上。modAction.IsActionEnabled 会问 modCaps
      当前宿主支不支持；不挂的话那套灰显机制等于没写——按钮照样亮着，点了才报错。
    - 高频命令直接上大按钮，长尾命令收进 menu 下拉。
      【下拉菜单要按内容起名】，不能四个组各放一个叫"更多"、图标还一样的抽屉——
      用户建立不起"某个功能在哪儿"的记忆，只能一个个点开找。
    - imageMso 用的是 Office 内置图标 ID，这样不必往包里塞图片资源。
-->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="Ribbon_OnLoad">
  <ribbon>
    <tabs>
      <tab id="tabToolbox" label="工具箱" insertBeforeMso="TabView">

        <!-- ===================== 撤销 ===================== -->
        <group id="grpUndo" label="撤销">
          <button id="btnUndoLast" tag="core.undoLast" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getScreentip="Ribbon_GetScreentip" getSupertip="Ribbon_GetSupertip"
                  imageMso="Undo" size="large"/>
          <button id="btnResetEnv" tag="core.resetEnv" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="RefreshStatus"/>
        </group>

        <!-- ===================== 文本处理 ===================== -->
        <group id="grpText" label="文本处理">
          <button id="btnCleanSpaces" tag="text.cleanSpaces" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="TextBoxInsert" size="large"/>
          <button id="btnToNumber" tag="text.toNumber" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="NumberFormatGeneral" size="large"/>
          <menu id="mnuCase" label="大小写与全半角" imageMso="FontDialog" size="large">
            <button id="btnUpper" tag="text.toUpper" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnLower" tag="text.toLower" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnProper" tag="text.toProper" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <menuSeparator id="sepCase"/>
            <button id="btnHalf" tag="text.toHalfWidth" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnFull" tag="text.toFullWidth" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
          </menu>
          <menu id="mnuExtract" label="提取内容" imageMso="FilterBySelection" size="large">
            <button id="btnDigits" tag="text.extractDigits" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnChinese" tag="text.extractChinese" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnEnglish" tag="text.extractEnglish" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
          </menu>
          <menu id="mnuTextMore" label="拆分与合并" imageMso="TableCellsSplit" size="large">
            <button id="btnAffix" tag="text.addAffix" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnRegex" tag="text.regexReplace" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnSplitCol" tag="text.splitColumn" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnNoBreaks" tag="text.removeLineBreaks" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <menuSeparator id="sepMerge"/>
            <button id="btnUnmerge" tag="cells.unmergeFill" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnMergeSame" tag="cells.mergeSame" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
          </menu>
        </group>

        <!-- ===================== 数据处理 ===================== -->
        <group id="grpData" label="数据处理">
          <button id="btnDelEmptyRows" tag="data.deleteEmptyRows" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="TableRowsDeleteExcel" size="large"/>
          <button id="btnDedupe" tag="data.deleteDuplicates" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="RemoveDuplicates" size="large"/>
          <button id="btnCompare" tag="data.compare" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="ViewSideBySide" size="large"/>
          <button id="btnUnpivot" tag="data.unpivot" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="PivotTableLayoutTabularForm" size="large"/>
          <menu id="mnuDataMore" label="去重与转置" imageMso="PivotTableLayoutCompactForm" size="large">
            <button id="btnDelEmptyCols" tag="data.deleteEmptyCols" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnMarkDup" tag="data.markDuplicates" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnUnique" tag="data.extractUnique" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnTranspose" tag="data.transpose" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
          </menu>
        </group>

        <!-- ===================== 工作表与文件 ===================== -->
        <group id="grpSheet" label="工作表与文件">
          <button id="btnMergeFolder" tag="merge.folder" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="FileOpenDatabase" size="large"/>
          <button id="btnMergeSheets" tag="sheet.mergeAll" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="TableMerge" size="large"/>
          <button id="btnSplitSheet" tag="sheet.splitByColumn" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="TableSplitCells" size="large"/>
          <menu id="mnuSheetMore" label="工作表" imageMso="SheetInsert" size="large">
            <button id="btnIndex" tag="sheet.createIndex" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnSortSheets" tag="sheet.sort" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnShowAll" tag="sheet.showAll" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnRenameSheets" tag="sheet.batchRename" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
          </menu>
          <menu id="mnuFile" label="文件批处理" imageMso="FileSaveAsExcelXlsx" size="large">
            <button id="btnFileList" tag="file.list" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnFileRename" tag="file.batchRename" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnExportSheets" tag="file.exportSheets" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnInsertImages" tag="file.insertImages" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
          </menu>
        </group>

        <!-- ===================== 公式与体检 ===================== -->
        <group id="grpFormula" label="公式与体检">
          <button id="btnAudit" tag="audit.scan" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="CheckSpelling" size="large"/>
          <button id="btnQuickClean" tag="audit.quickClean" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="Repair" size="large"/>
          <button id="btnToValues" tag="formula.toValues" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="PasteValues" size="large"/>
          <menu id="mnuFormulaMore" label="公式工具" imageMso="FunctionsInsertGallery" size="large">
            <button id="btnFindErrors" tag="formula.findErrors" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnWrapIfError" tag="formula.wrapIfError" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnToggleFormula" tag="formula.toggleView" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <menuSeparator id="sepFormula"/>
            <button id="btnBreakLinks" tag="formula.breakLinks" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnCleanNames" tag="formula.cleanNames" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnCleanRules" tag="formula.cleanRules" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
          </menu>
        </group>

        <!-- ===================== 可视化 ===================== -->
        <group id="grpViz" label="可视化">
          <button id="btnDataBars" tag="viz.dataBars" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="ConditionalFormattingDataBars" size="large"/>
          <button id="btnColorScale" tag="viz.colorScale" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="ConditionalFormattingColorScales" size="large"/>
          <button id="btnQuickChart" tag="viz.quickChart" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="ChartInsert" size="large"/>
          <menu id="mnuVizMore" label="条件格式与图表" imageMso="ConditionalFormattingMenu" size="large">
            <button id="btnIconSet" tag="viz.iconSet" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnSparklines" tag="viz.sparklines" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnUnifyCharts" tag="viz.unifyCharts" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <menuSeparator id="sepViz"/>
            <button id="btnClearCF" tag="viz.clearCF" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
          </menu>
        </group>

        <!-- ===================== 辅助 ===================== -->
        <group id="grpMisc" label="辅助">
          <toggleButton id="btnSpotlight" tag="misc.spotlight"
                        onAction="Ribbon_OnToggle" getPressed="Ribbon_GetPressed"
                        getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                        getSupertip="Ribbon_GetSupertip"
                        imageMso="LightingGallery" size="large"/>
          <button id="btnAmount" tag="misc.amountToChinese" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="CurrencyOther" size="large"/>
          <menu id="mnuMiscMore" label="身份证与日期" imageMso="DateAndTimeInsert" size="large">
            <button id="btnParseId" tag="misc.parseId" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
            <button id="btnNormalizeDates" tag="misc.normalizeDates" onAction="Ribbon_OnAction"
                    getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                    getSupertip="Ribbon_GetSupertip"/>
          </menu>
        </group>

        <!-- ===================== 关于 ===================== -->
        <group id="grpAbout" label="关于">
          <button id="btnSelfTest" tag="core.selfTest" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="AcceptInvitation"/>
          <button id="btnAbout" tag="core.about" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="Info"/>
        </group>

      </tab>
    </tabs>
  </ribbon>
</customUI>
