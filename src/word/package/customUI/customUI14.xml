<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Word 工具箱选项卡。

  "关于"按钮的回调直接写在 modRibbon.Ribbon_OnAction 里（不经过
  RunAction/modActionRegistry），其余三个是首批样板命令，走完整管线。

  前三个命令（audit/cleanSpaces/updateFields）的 imageMso 复用 Excel
  工具箱已经验收过的 ID（见 docs/图标验收记录.md）——imageMso 是 Office
  全局图标集，不是逐应用各自一套，Excel 里能画出来的 ID 在 Word 里
  同样有效。第二批三个命令（removeEmptyParagraphs/replaceText/
  acceptAllRevisions）的 imageMso 是凭对 Office 内置图标集的了解选的，
  不在 Excel 已验收清单里，比前三个更没把握——坏掉的表现是【静默不画
  图标】，不是报错，按钮本身仍然能点、功能不受影响。所有六个都还没在
  Word 的功能区里实际肉眼看过一遍，按项目自己的规矩（"存在不等于
  画得出来"）都算未验收，等真机能装上这个 .dotm 时统一补验收。
-->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="Ribbon_OnLoad">
  <ribbon>
    <tabs>
      <tab id="tabWordToolbox" label="Word 工具箱">
        <group id="grpCore" label="核心">
          <button id="btnAbout" label="关于" tag="core.about" onAction="Ribbon_OnAction"
                  imageMso="Info" size="large" />
        </group>
        <group id="grpCommands" label="命令">
          <button id="btnAudit" tag="word.audit" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="ErrorChecking" size="large" />
          <button id="btnCleanSpaces" tag="word.cleanSpaces" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="TextBoxInsert" size="large" />
          <button id="btnUpdateFields" tag="word.updateFields" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="Refresh" size="large" />
          <button id="btnRemoveEmptyParagraphs" tag="word.removeEmptyParagraphs" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="TableEraser" size="large" />
          <button id="btnReplaceText" tag="word.replaceText" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="EditReplace" size="large" />
          <button id="btnAcceptAllRevisions" tag="word.acceptAllRevisions" onAction="Ribbon_OnAction"
                  getLabel="Ribbon_GetLabel" getEnabled="Ribbon_GetEnabled"
                  getSupertip="Ribbon_GetSupertip"
                  imageMso="ReviewAcceptChange" size="large" />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
